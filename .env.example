# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram (user account, MTProto) --------------------------------------
# Create an application at https://my.telegram.org/apps to get these two.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# The group to monitor. Accepts a numeric id (-1001234567890), a public
# username (@my_signals_group), or a t.me link. Everything else is ignored.
TELEGRAM_TARGET_CHAT=@my_signals_group

# Your phone in international format. Only used for the first interactive
# login; afterwards the session file is reused.
TELEGRAM_PHONE=+15551234567

# Name of the Telethon session file (a `<name>.session` file is created).
# On Railway use the volume: TELEGRAM_SESSION=/data/signal_monitor (the
# container defaults to that when unset). At container start the session is
# checked with Telegram; a REJECTED one is replaced from TELEGRAM_SESSION_B64
# only if that replacement is accepted. TELEGRAM_SESSION_CHECK=0 skips it.
TELEGRAM_SESSION=signal_monitor

# --- Claude Code CLI ---------------------------------------------------------
# No API key here. Analysis runs through the locally installed `claude` CLI,
# authenticated once via `claude auth login` (a Claude subscription — NOT
# `claude auth login --console`, which bills through an Anthropic API key).
#
# Path to the CLI executable. Leave as `claude` if it's on PATH; otherwise
# set the full path (e.g. C:\Users\you\AppData\Roaming\npm\claude.cmd).
CLAUDE_CLI_PATH=claude

# Model alias/id to pass as --model, e.g. sonnet, opus, haiku, fable. Leave
# empty to use whatever model you already have configured in the CLI.
CLAUDE_MODEL=

# Safety bound on agentic turns per call (print-mode --max-turns). The CLI
# has no tools available for this task, so it should always finish in one.
CLAUDE_MAX_TURNS=3

CLAUDE_MAX_RETRIES=3
# CLI calls spawn a fresh process and load context each time, so they're
# slower than a raw API call — give them more headroom than you would an API.
CLAUDE_TIMEOUT_SECONDS=180

# --- Signal Parser (RFC-001) -------------------------------------------------
# shadow  = Claude still analyses every message (no behaviour change); the
#           regex parser's verdict is only logged/compared for calibration.
# active  = a confident regex verdict is used directly and Claude is skipped;
#           anything ambiguous still falls back to Claude.
# off     = pre-RFC-001 behaviour — Claude analyses every message, regex
#           parser not consulted at all.
# Start in "shadow", check the session summary's shadow-agreement rate, and
# only switch to "active" once you're comfortable with it.
SIGNAL_PARSER_MODE=shadow

# --- Telegram Bot Notifications (RFC-002, optional) --------------------------
# Sends every completed analysis to a Telegram chat automatically, and
# answers /start /help /status /stats /latest /history there. This is a
# SEPARATE credential from the user-account session above — a real bot,
# created via @BotFather — and is fully optional: leave both empty and
# nothing else in this file changes. A misconfigured or unreachable bot can
# never stop message ingestion or analysis; failures are only logged.
#
# 1. Message @BotFather on Telegram, /newbot, and copy the token it gives you.
# 2. Add the bot to the chat/channel you want notified (as admin, for a
#    channel), then set the chat id below (or @channelusername for a public
#    channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_ID=

# Retry/backoff tuning. Sensible defaults — most setups never need to change these.
TELEGRAM_BOT_MAX_RETRIES=5
TELEGRAM_BOT_RETRY_BASE_DELAY=2.0
TELEGRAM_BOT_RETRY_MAX_DELAY=60.0
# Default count for a bare /history with no argument. /history and /latest
# read from the persistent storage below (RFC-003), so there's no buffer
# size to configure here anymore.
TELEGRAM_BOT_HISTORY_DISPLAY_DEFAULT=5
# Bound on the duplicate-notification guard's memory (oldest entries are
# dropped first once this many message ids have been sent).
TELEGRAM_BOT_DEDUP_CACHE_SIZE=2000

# --- Pipeline --------------------------------------------------------------
# Concurrent analyses. 2-4 is plenty for a normal signals group.
WORKER_COUNT=2
# Messages buffered while workers are busy; beyond this, messages are dropped
# with a loud error rather than blocking Telegram reception.
QUEUE_MAXSIZE=200
# Longer messages are truncated before being sent to the CLI.
MAX_MESSAGE_CHARS=8000
# Also analyse edits to existing messages.
ANALYSE_EDITS=false

# --- Output ----------------------------------------------------------------
LOG_LEVEL=INFO
# Optional: mirror logs to a file.
# LOG_FILE=logs/monitor.log
# Optional: append every structured result as one JSON object per line.
# JSONL_OUTPUT=data/signals.jsonl
COLOR_OUTPUT=true
SHOW_JSON=true

# --- Storage (RFC-003) -------------------------------------------------------
# SQLite database of completed analyses (created automatically). This is
# what makes /latest, /history and /stats work after a restart — JSONL above
# stays a separate, append-only audit log and is unaffected.
STORAGE_DB_PATH=data/signals.db

# --- Market Data (RFC-004, optional; wired into the pipeline in the -----------
# --- integration phase) -------------------------------------------------------
# Get a free key at https://twelvedata.com/. Leave empty to leave market data
# disabled entirely: /price replies "not configured", and every signal is
# still analysed/notified/stored exactly as before — structure/SMC/scoring/
# decision enrichment is simply skipped (never fabricated) for that message.
TWELVE_DATA_API_KEY=
# Seconds a quote/candle result is cached before a fresh request is made.
MARKET_DATA_CACHE_TTL=30
# Which timeframe the pipeline requests candles for when enriching a signal
# with structure/SMC/scoring/decision analysis. One of M1/M5/M15/M30/H1/H4/D1.
MARKET_DATA_TIMEFRAME=H1

# --- Independent analyst (analyst/, shadow only) -----------------------------
# off (default): not constructed at all — no tables, no extra requests.
# shadow: after the live report, every XAUUSD signal is also judged by the
# independent multi-timeframe analyst (H4/H1/M15/M5) and recorded in its own
# write-once tables in STORAGE_DB_PATH, with outcome tracking. It sends no
# Telegram message and never changes the live verdict; the configured bot
# chat can pull the latest card with /shadow. There is no live mode.
INDEPENDENT_ANALYSIS_MODE=off
# Net reward-to-risk minimums (after spread and slippage) for an independent
# proposal and for the original signal. Optional.
# ANALYST_MIN_RR=1.5
# ANALYST_SIGNAL_MIN_RR=1.0

# --- Strategy shadow evaluation (strategy_shadow/) ---------------------------
# on: each XAUUSD signal's live snapshot is also judged by the baseline replay
# and three candidate strategies (htf_regime, valid_events, range_filter),
# recorded write-once in STORAGE_DB_PATH, and the signal's outcome tracked.
# Never changes the live verdict or what the bot sends. Default off.
STRATEGY_SHADOW_MODE=off
# on: registers /strategy_shadow and /strategy_shadow_latest, answered only
# for TELEGRAM_BOT_CHAT_ID. Default off.
STRATEGY_SHADOW_REPORTING=off
# Optional YYYY-MM-DD: signals from this UTC date on form the "confirmation"
# cohort, kept out of every report until deliberately opened.
# STRATEGY_SHADOW_CONFIRMATION_START=
